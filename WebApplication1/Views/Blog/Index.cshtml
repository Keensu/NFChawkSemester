@model IEnumerable<NFChawk.Models.Entities.BlogPost>
@{
	ViewData["Title"] = "Blog";
}
<section class="common-banner">
	<div class="common-banner__bg" style="background-image: url(images/banner/common-banner-03.jpg);"></div>
	<div class="common-banner__title">
		<h2>Blog Page</h2>
		<a href="@Url.Action("Index", "Home")">home / </a>
		<span> Blog</span>
	</div>
</section>

<section class="blog-page">
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<div class="blog-page-title">
					<div class="common-title">
						<h2>Our Blog</h2>
					</div>
				</div>
			</div>

			<div class="col-lg-12">
				<div class="button-group filter-button-group">
					<button class="active" data-filter="*">All</button>
					<button data-filter=".digital">Digital Art</button>
					<button data-filter=".collectibles">Collectibles</button>
					<button data-filter=".domains">Domains</button>
				</div>
			</div>
		</div>

		<div class="blog-page__container">
			<div class="row filter-row">
				@foreach (var item in Model)
				{
					<div class="col-lg-4 col-md-6 filter-Item @item.Category">
						<div class="blog-page__single">
							<div class="image">
								<a href="@Url.Action("Single", "Blog", new { id = item.Id })">
									<img src="~/images/blog/@item.ImageUrl" alt="@item.Title">
								</a>
								<div class="note">@item.CategoryDisplay</div>
							</div>
							<div class="blog-page__content">
								<a href="@Url.Action("Single", "Blog", new { id = item.Id })">@item.Title</a>
								<div class="info">
									<ul>
										<li><i class="fas fa-clock"></i> @item.CreatedAt.ToString("MMMM dd, yyyy")</li>
										<li><i class="icon-love"></i> 55</li>
									</ul>
								</div>
							</div>
						</div>
					</div>
				}
			</div>
		</div>

		<div class="row">
			<div class="col-lg-12">
				<div class="live-page__btn">
					<a href="#" class="btn-1">View All Items <span></span></a>
				</div>
			</div>
		</div>
	</div>
</section>