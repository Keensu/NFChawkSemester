@using Microsoft.AspNetCore.Identity
@using NFChawk.Models.Enums
@using NFChawk.Models.ViewModels
@model HomeViewModel
@inject UserManager<NFChawk.Models.Entities.User> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
    ViewData["Title"] = "Home Page";
}

<section class="main-slider slider-one">
    <div class="image-layer-one" style="background-image: url(@Url.Content("~/images/banner/banner-bg-01.png"));"></div>

    <div class="light-one">
        <img src="~/images/shapes/purple-light.png" alt="light">
    </div>
    <div class="light-two">
        <img src="~/images/shapes/orange-light.png" alt="light">
    </div>
    <div class="light-three">
        <img src="~/images/shapes/red-light.png" alt="light">
    </div>
    <div class="light-four">
        <img src="~/images/shapes/green-light.png" alt="light">
    </div>

    <div class="slider-one__wrap">
        <div class="swiper-container slider-one-style1">
            <div class="swiper-container thm-swiper__slider" data-swiper-options='{"slidesPerView": 1, "loop": true,
                "effect": "fade",
                "speed": 3000,
                "pagination": {
                "el": "#main-slider-pagination",
                "type": "bullets",
                "clickable": true
                },
                "navigation": {
                "nextEl": "#main-slider__swiper-button-next",
                "prevEl": "#main-slider__swiper-button-prev"
                },
                "autoplay": {
                "delay": 6000
                }
                }'>

                <div class="swiper-wrapper">
                    @if (Model.FeaturedNfts != null && Model.FeaturedNfts.Any())
                    {
                        foreach (var nft in Model.FeaturedNfts)
                        {
                            <div class="swiper-slide">
                                <div class="container">
                                    <div class="row">
                                        <div class="col-lg-7">
                                            <div class="slider-one__content">
                                                <div class="slider-one__content__inner">
                                                    <div class="slider-one__title__box">
                                                        <h1 class="slider-one__title">Discover, Collect & <br> Sell Extraordinary <br> NFT’s.</h1>
                                                        <p class="slider-one__text">There are many variations of NFT's available, <br> Get'em all now!</p>
                                                    </div>
                                                    <div class="slider-one__btn-box">
                                                        <div class="btn-link">
                                                            <a href="@Url.Action("Index", "Contact")" class="btn-1">Explore Now <i class="icon-round-arrow"></i> <span></span></a>
                                                        </div>
                                                        <div class="btn-link btn-box-two">
                                                            <a href="@(User.Identity != null && User.Identity.IsAuthenticated ? Url.Action("Create", "NFT") : Url.Action("SignUp", "Auth"))">Create NFT<i class="icon-right-angle"></i></a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-5">
                                            <div class="slider-one__right-content">
                                                <div class="slider-one__right-img">
                                                    <img src="@Url.Content(nft.ImageUrl)" alt="@nft.Name">
                                                </div>
                                                <div class="content-box">
                                                    <div class="content-box-title">
                                                        <div class="content-box-title-left">
                                                            <h4><a href="@Url.Action("Index", "ItemDetails", new { id = nft.Id, type = "nft" })">@nft.Name</a></h4>
                                                        </div>
                                                        <div class="member-info">
                                                            <p>
                                                                @if (nft.Owner != null && !string.IsNullOrWhiteSpace(nft.Owner.UserName))
                                                                {
                                                                    @nft.Owner.UserName
                                                                }
                                                                else if (nft.Author != null && !string.IsNullOrWhiteSpace(nft.Author.UserName))
                                                                {
                                                                    @nft.Author.UserName
                                                                }
                                                                else
                                                                {
                                                                    @:Anonymous
                                                                }
                                                            </p>
                                                            <span>Owner</span>
                                                        </div>
                                                        <div class="content-box-title-right">
                                                            <h3>@nft.Price ETH</h3>
                                                            @if (nft.Status == NFTStatus.IsForSale)
                                                            {
                                                                <p>Active</p>
                                                            }
                                                            else
                                                            {
                                                                <p>Not for Sale</p>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="content-box-btn">
                                                        @{
                                                            var isOwner = currentUser != null && (nft.OwnerId == currentUser.Id || (nft.OwnerId == null && nft.AuthorId == currentUser.Id));
                                                        }

                                                        @if (nft.Status == NFTStatus.OnAuction)
                                                        {
                                                            <a href="@Url.Action("Details", "Auction", new { id = nft.Auction?.Id })" class="btn-1 left-btn">GO TO AUCTION <span></span></a>
                                                        }
                                                        else if (isOwner)
                                                        {
                                                            <a href="@Url.Action("Index", "ItemDetails", new { id = nft.Id, type = "nft" })" class="btn-1 left-btn">MY ITEM <span></span></a>
                                                        }
                                                        else if (nft.Status == NFTStatus.IsForSale)
                                                        {
                                                            <a href="@Url.Action("Index", "ItemDetails", new { id = nft.Id, type = "nft" })" class="btn-1 left-btn">BUY NOW <span></span></a>
                                                        }
                                                        else
                                                        {
                                                            <a href="@Url.Action("Index", "ItemDetails", new { id = nft.Id, type = "nft" })" class="btn-1 left-btn">VIEW DETAILS <span></span></a>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</section>

