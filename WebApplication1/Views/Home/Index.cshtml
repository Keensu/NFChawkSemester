            </div>
            <div class="col-lg-3 col-md-6">
                <div class="work__single wow fadeInUp" data-wow-delay="400ms">
                    <div class="work__single-icon">
                        <i class="icon-cart"></i>
                    </div>
                    <div class="work__single-title">
                        <a href="@(User.Identity != null && User.Identity.IsAuthenticated ? Url.Action("Index", "Personal") : Url.Action("SignUp", "Auth"))">Sell your NFTs</a>
                    </div>
                    <div class="work__single-text">
