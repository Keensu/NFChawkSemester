@model NFChawk.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<section class="common-banner">
    <div class="common-banner__bg" style="background-image: url(images/banner/common-banner-03.jpg);"></div>
    <div class="common-banner__title">
        <h2>New Password</h2>
        <a href="@Url.Action("Index", "Home")">home / </a>
        <span> Reset Password</span>
    </div>
</section>

<section class="log-in">
    <div class="container">
        <div class="log-in__container">
            <div class="log-in__title">
                <h4>Set new password</h4>
                <p>Please enter your new secure password</p>
            </div>
            <div class="log-in__form">
                <form asp-action="ResetPassword" asp-controller="Auth" method="post">
                    <div asp-validation-summary="All" class="text-danger" style="margin-bottom: 20px;"></div>

                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />

                    <div class="input">
                        <input asp-for="Password" class="common-input" placeholder="New Password" required>
                        <span><img src="~/images/icons/lock.png" alt="pass"></span>
                    </div>

                    <div class="input">
                        <input asp-for="ConfirmPassword" class="common-input" placeholder="Confirm New Password" required>
                        <span><img src="~/images/icons/lock.png" alt="pass"></span>
                    </div>

                    <div class="log-in__btn">
                        <button type="submit" class="btn-1">Update Password <span></span></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>