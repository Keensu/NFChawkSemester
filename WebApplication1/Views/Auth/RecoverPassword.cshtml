@{
    ViewData["Title"] = "Recover Password";
}
<!-- common banner -->
<section class="common-banner">
    <div class="common-banner__bg" style="background-image: url(images/banner/common-banner-03.jpg);"></div>
    <div class="common-banner__title">
        <h2>Recover Password</h2>
        <a href="@Url.Action("Index", "Home")">home / </a>
        <span> Recover Password</span>
    </div>
</section>
<!-- common banner -->
<!-- log in -->
<section class="log-in">
    <div class="container">
        <div class="log-in__container">
            <div class="log-in__title">
                <h4>Reset your password</h4>
                <p>We will send a password reset link</p>
            </div>
            <div class="log-in__form">
                <form method="post" action="#">
                    <div class="input">
                        <input type="email" name="email" class="common-input" placeholder="Email" required>
                        <span><img src="~/images/icons/email.png" alt="user"></span>
                    </div>
                    <div class="log-in__btn">
                        
                        <button type="submit" class="btn-1">Send Reset Link <span></span></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>