@{
    ViewData["Title"] = "Check Your Email";
}

<section class="common-banner">
    <div class="common-banner__bg" style="background-image: url(images/banner/common-banner-03.jpg);"></div>
    <div class="common-banner__title">
        <h2>Email Sent</h2>
        <a href="@Url.Action("Index", "Home")">home / </a>
        <span> Recovery</span>
    </div>
</section>

<section class="log-in">
    <div class="container">
        <div class="log-in__container">
            <div class="log-in__title">
                <h4>Check your inbox</h4>
                <p>If an account exists for that email, we have sent a password reset link. Please check your email (and spam folder).</p>
            </div>
            <div class="log-in__btn">
                <a href="@Url.Action("LogIn", "Auth")" class="btn-1">Back to Login <span></span></a>
            </div>
        </div>
    </div>
</section>