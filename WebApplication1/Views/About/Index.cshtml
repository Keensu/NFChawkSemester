@{
	ViewData["Title"] = "About";
}
<!-- common banner -->
<section class="common-banner">
	<div class="common-banner__bg" style="background-image: url(images/banner/common-banner-01.jpg);"></div>
	<div class="common-banner__title">
		<h2>About Us</h2>
		<a href="@Url.Action("Index", "Home")">home / </a>
		<span> About us</span>
	</div>
</section>
<!-- common banner -->
<!-- about page -->
<section class="about-page">
	<div class="container">
		<div class="row">
			<div class="col-lg-5">
				<div class="about__image-box">
					<img src="~/images/resource/about-01.jpg" alt="photo">
					<div class="box rotate">
						<img src="~/images/shapes/box.png" alt="box">
					</div>
					<div class="box-two rotate">
						<img src="~/images/shapes/box-2.png" alt="box">
					</div>
				</div>
			</div>
			<div class="col-lg-7">
				<div class="about__content">
					<h2>About Our Company</h2>
					<p>
						We are a cutting-edge NFT platform operating at the intersection of traditional creativity and the digital revolution. Our mission is to provide artists, collectors, and crypto enthusiasts with a secure, seamless, and inspiring space to mint, buy, and sell unique digital assets.
					</p>
					<p>
						We believe that every digital canvas, 3D model, and audio track deserves permanent recognition on the blockchain. We don't just facilitate transactions; we empower creators to monetize their talent and help collectors discover true digital treasures to build the galleries of tomorrow.
					</p>
					<h3>
						Why Choose Us:
					</h3>
					<p>
						Absolute Transparency: Powered by smart contract technology, every single transaction is secure, verifiable, and authentic.
					</p>
					<p>
						Creator-Centric: We offer fair terms and provide a launchpad for emerging digital artists to make their mark.
					</p>
					<p>
						Seamless Experience: Our intuitive interface is built for both seasoned web3 investors and newcomers taking their first steps into the crypto space.
					</p>
				</div>
			</div>
		</div>
	</div>
</section>
<!-- about page -->
