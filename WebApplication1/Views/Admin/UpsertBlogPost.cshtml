@model NFChawk.Models.Entities.BlogPost

@{
    bool isEdit = Model != null && Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Post" : "Create Post";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Dashboard</title>
    <link class="icon" type="image/png" href="~/images/favicon1.png" />
    <link rel="stylesheet" href="~/css/app.css" />
    <script src="~/js/app.js" defer></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>

<body class="is-header-blur bg-slate-50 dark:bg-navy-900 font-sans p-6">
    <div class="max-w-4xl mx-auto card p-6 bg-white dark:bg-navy-750 border border-slate-150 dark:border-navy-600 rounded-xl shadow-sm transition-all">

        <div class="flex items-center justify-between mb-6 border-b border-slate-150 dark:border-navy-700 pb-4">
            <div>
                <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">@ViewData["Title"]</h2>
                <p class="text-sm mt-1 text-slate-400 dark:text-navy-300">Administrative tools, database entity controllers and state triggers.</p>
            </div>
            <span class="text-xs font-bold uppercase tracking-wider text-primary dark:text-accent-light">Blog Management</span>
        </div>

        <form asp-action="@(isEdit ? "EditBlogPost" : "CreateBlogPost")" method="post" enctype="multipart/form-data" class="space-y-5">
            @Html.AntiForgeryToken()

            @if (isEdit)
            {
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />
                <input type="hidden" asp-for="ImageUrl" />
            }

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                <div class="flex flex-col gap-1.5 md:col-span-2">
                    <label asp-for="Title" class="text-sm font-medium text-slate-600 dark:text-navy-200">Post Title</label>
                    <input asp-for="Title" class="w-full px-3 py-2 bg-slate-50 dark:bg-navy-800 border border-slate-150 dark:border-navy-600 rounded-lg text-slate-900 dark:text-white focus:outline-hidden focus:ring-2 focus:ring-primary transition-all placeholder-slate-400" placeholder="Enter post title..." />
                    <span asp-validation-for="Title" class="text-xs font-medium text-error mt-1"></span>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label asp-for="Category" class="text-sm font-medium text-slate-600 dark:text-navy-200">Category (Slug)</label>
                    <input asp-for="Category" class="w-full px-3 py-2 bg-slate-50 dark:bg-navy-800 border border-slate-150 dark:border-navy-600 rounded-lg text-slate-900 dark:text-white focus:outline-hidden focus:ring-2 focus:ring-primary transition-all" placeholder="e.g., nft-news" />
                    <span asp-validation-for="Category" class="text-xs font-medium text-error mt-1"></span>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label asp-for="CategoryDisplay" class="text-sm font-medium text-slate-600 dark:text-navy-200">Category (Display Name)</label>
                    <input asp-for="CategoryDisplay" class="w-full px-3 py-2 bg-slate-50 dark:bg-navy-800 border border-slate-150 dark:border-navy-600 rounded-lg text-slate-900 dark:text-white focus:outline-hidden focus:ring-2 focus:ring-primary transition-all" placeholder="e.g., NFT News" />
                    <span asp-validation-for="CategoryDisplay" class="text-xs font-medium text-error mt-1"></span>
                </div>

                <div class="flex flex-col gap-1.5 md:col-span-2">
                    <label class="text-sm font-medium text-slate-600 dark:text-navy-200">Cover Image</label>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-center p-4 bg-slate-50 dark:bg-navy-800 border border-slate-150 dark:border-navy-600 rounded-xl">
                        <div class="sm:col-span-1 flex items-center justify-center bg-slate-200 dark:bg-navy-700 h-32 rounded-lg overflow-hidden border border-slate-300 dark:border-navy-500 relative group">
                            <img id="imagePreview"
                                 src="@(isEdit && !string.IsNullOrEmpty(Model.ImageUrl) ? Model.ImageUrl : "/images/placeholder.png")"
                                 alt="Preview"
                                 class="w-full h-full object-cover" />
                        </div>

                        <div class="sm:col-span-2 space-y-2">
                            <div class="relative flex items-center justify-center w-full">
                                <label class="flex flex-col items-center justify-center w-full h-32 border-2 border-slate-300 dark:border-navy-500 border-dashed rounded-lg cursor-pointer bg-white dark:bg-navy-750 hover:bg-slate-100 dark:hover:bg-navy-700 transition-all">
                                    <div class="flex flex-col items-center justify-center pt-5 pb-6 text-center px-2">
                                        <svg class="w-8 h-8 mb-2 text-slate-400 dark:text-navy-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 16">
                                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 13h3a3 3 0 0 0 0-6h-.025A5.56 5.56 0 0 0 16 6.5 5.5 5.5 0 0 0 5.207 5.021C5.137 5.017 5.071 5 5 5a4 4 0 0 0 0 8h2.167M10 15V6m0 0L8 8m2-2 2 2" />
                                        </svg>
                                        <p class="text-xs font-semibold text-slate-500 dark:text-navy-200" id="uploadStatusText">Click to upload or drag & drop</p>
                                        <p class="text-tiny text-slate-400 dark:text-navy-300 mt-0.5">SVG, PNG, JPG or GIF</p>
                                    </div>
                                    <input type="file" id="blogImageInput" name="ImageFile" accept="image/*" class="hidden" onchange="previewImage(this)" />
                                </label>
                            </div>
                            <span class="text-tiny text-slate-400 dark:text-navy-300 block">
                                @(isEdit ? "Leave empty to keep the current cover image." : "An image file is highly recommended for the post card layout.")
                            </span>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col gap-1.5 md:col-span-2">
                    <label asp-for="Content" class="text-sm font-medium text-slate-600 dark:text-navy-200">Content</label>
                    <textarea asp-for="Content" rows="8" class="w-full px-3 py-2 bg-slate-50 dark:bg-navy-800 border border-slate-150 dark:border-navy-600 rounded-lg text-slate-900 dark:text-white focus:outline-hidden focus:ring-2 focus:ring-primary transition-all font-sans" placeholder="Enter content or HTML markup..."></textarea>
                    <span asp-validation-for="Content" class="text-xs font-medium text-error mt-1"></span>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-150 dark:border-navy-700 mt-6">
                <a asp-action="Index" class="px-4 py-2 text-sm font-medium text-slate-600 dark:text-navy-200 bg-white dark:bg-navy-700 border border-slate-150 dark:border-navy-600 rounded-lg hover:bg-slate-50 dark:hover:bg-navy-600 transition-colors cursor-pointer btn1">
                    Cancel
                </a>
                <button type="submit" class="px-5 py-2 text-sm font-medium text-white bg-primary hover:bg-primary-focus dark:bg-accent dark:hover:bg-accent-focus rounded-lg shadow-xs transition-colors cursor-pointer btn1">
                    @(isEdit ? "Save Changes" : "Publish Post")
                </button>
            </div>
        </form>
    </div>

    <script>
        function previewImage(input) {
            const preview = document.getElementById('imagePreview');
            const statusText = document.getElementById('uploadStatusText');

            if (input.files && input.files[0]) {
                const file = input.files[0];
                const reader = new FileReader();

                reader.onload = function (e) {
                    preview.src = e.target.result;
                }

                reader.readAsDataURL(file);

                const fileName = file.name.length > 22 ? file.name.substring(0, 20) + '...' : file.name;
                statusText.innerText = "Selected: " + fileName;
                statusText.classList.remove('text-slate-500');
                statusText.classList.add('text-primary', 'dark:text-accent-light');
            }
        }
    </script>
</body>
</html>