@model NFChawk.Models.DTO.CreateAuctionDto
@{
    ViewData["Title"] = "Create Auction";
}

<div class="auction-create-page">
    <div class="container">
        <div class="auction-create-card">
            <div class="auction-create-header">
                <h2>Create NFT Auction</h2>
                <p>Configure your auction settings</p>
            </div>

            <form asp-action="Create" method="post" class="auction-form">
                <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 15px; font-weight: bold;"></div>
                <input type="hidden" asp-for="NFTId" />

                <div class="form-group">
                    <label asp-for="StartPrice">Starting Price</label>
                    <input asp-for="StartPrice" type="number" step="0.01" class="auction-input" required />
                    <span asp-validation-for="StartPrice" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MinBidStep">Minimum Bid Step</label>
                    <input asp-for="MinBidStep" type="number" step="0.01" class="auction-input" required />
                    <span asp-validation-for="MinBidStep" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="EndTime">Auction End Time</label>
                    <input asp-for="EndTime" type="datetime-local" class="auction-input" asp-format="{0:yyyy-MM-ddTHH:mm}" required />
                    <span asp-validation-for="EndTime" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-1">
                    Create Auction
                    <span></span>
                </button>
            </form>
        </div>
    </div>
</div>